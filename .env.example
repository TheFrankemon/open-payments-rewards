# API (server/)
PORT=3001
WEB_PUBLIC_URL=http://localhost:5173

# Open Payments — merchant/client that signs API requests (HALT: fill before M3)
# https://openpayments.dev/sdk/before-you-begin/
# https://wallet.interledger-test.dev/
OP_WALLET_ADDRESS_URL=
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key

# Optional: prefill receiver in the React form (web/.env)
# VITE_DEFAULT_RECEIVER_URL=https://wallet.interledger-test.dev/your-user
