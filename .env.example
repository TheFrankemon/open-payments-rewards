# API (server/)
PORT=3001
WEB_PUBLIC_URL=http://localhost:5173

# Checkout payer — user wallet that debits for the purchase (HTTPS, no trailing slash)
# Example: https://ilp.interledger-test.dev/fkmnrw-2
OP_WALLET_ADDRESS_URL=
# Must match "kid" in {OP_WALLET_ADDRESS_URL}/jwks.json (not an old id from the wallet UI)
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key

# Merchant store wallet — receives purchase funds (EUR on testnet)
# Example: https://ilp.interledger-test.dev/e21287fb
OP_STORE_RECEIVER_WALLET_URL=

# SGD rewards pool — sends 2% cashback after each paid checkout
# Example: https://ilp.interledger-test.dev/fkmn-rewards
OP_REWARDS_WALLET_URL=
# Must match "kid" in {OP_REWARDS_WALLET_URL}/jwks.json
OP_REWARDS_KEY_ID=
# OP_REWARDS_PRIVATE_KEY_PATH=./rewards.key

# Optional: default 200 = 2%
# OP_CASHBACK_RATE_BPS=200

# Optional R4: pre-approved standing grant access token (skips /rewards setup UI)
# OP_REWARDS_STANDING_GRANT_ACCESS_TOKEN=
# OP_REWARDS_STANDING_DEBIT_MAJOR=5000
# OP_REWARDS_STANDING_INTERVAL=R/2025-01-01T00:00:00Z/P1D
